{
  "manifest_version": 3,
  "name": "ytsum",
  "version": "1.0.0",
  "description": "Un clic sur une vidéo YouTube : le transcript part dans ChatGPT avec ton prompt de résumé.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Résumer cette vidéo avec ChatGPT (Alt+S)"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "offscreen",
    "clipboardWrite",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "chatgpt.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "summarize": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Résumer la vidéo YouTube de l'onglet actif"
    }
  }
}
